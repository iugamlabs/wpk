<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AssemblyName>wpk</AssemblyName>
    <RootNamespace>Wpk.Cli</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <MicrosoftManagementDeployment-FactoryLinkage>static</MicrosoftManagementDeployment-FactoryLinkage>
    <!-- CAF5 + STJ source-gen are AOT-oriented; Spectre.Console / WinGet ComInterop may still emit link-time trim noise. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <!-- Self-contained / AOT publish sets PublishTrimmed; third-party WinRT/Spectre assemblies are not fully trim-clean (IL2104). -->
  <PropertyGroup Condition="'$(PublishTrimmed)' == 'true' or '$(PublishAot)' == 'true'">
    <NoWarn>$(NoWarn);IL2104</NoWarn>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ConsoleAppFramework" Version="5.8.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <ProjectReference Include="../Wpk.Core/Wpk.Core.csproj" />
    <PackageReference Include="Microsoft.WindowsPackageManager.ComInterop" Version="1.29.380" GeneratePathProperty="true" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <None Include="../../README.md" Link="README.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../README.zh-CN.md" Link="README.zh-CN.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../docs/**/*.md" Link="docs/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <!-- The WinGet activation factory needs the WinRT metadata alongside the executable. -->
    <None Include="$(PkgMicrosoft_WindowsPackageManager_ComInterop)/lib/uap10.0/Microsoft.Management.Deployment.winmd"
          Link="Microsoft.Management.Deployment.winmd" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
